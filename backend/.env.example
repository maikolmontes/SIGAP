# ================================
# Base de datos PostgreSQL
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigap
DB_USER=postgres
DB_PASSWORD=
PORT=3000

# ================================
# Autenticacion
# ================================
JWT_SECRET=
GOOGLE_CLIENT_ID=

# ================================
# Notificaciones por correo (Gmail / Google Workspace)
# --------------------------------
# EMAIL_PASS es la "Contrasena de aplicacion" de 16 caracteres que
# genera Google (requiere verificacion en dos pasos activa).
# Puerto 465 -> EMAIL_SECURE=true | Puerto 587 -> EMAIL_SECURE=false
# ================================
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=sigap.cesmag@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=SIGAP - Universidad CESMAG

# URL del frontend usada en los botones de los correos
FRONTEND_URL=http://localhost:5173

# Pruebas: si se define, TODOS los correos se redirigen a esta direccion
EMAIL_REDIRECT_TO=

# Avisos masivos automaticos (desactivados por defecto).
# Con false se siguen pudiendo enviar manualmente desde
# POST /api/notificaciones/periodo/:id  y  ?notificar=true en la importacion.
EMAIL_AVISO_PERIODO=false
EMAIL_AVISO_ASIGNACIONES=false

# ================================
# Analitica asistida (Gemini)
# La clave vive SOLO en el backend. Nunca usar prefijo VITE_.
# Sin clave, la analitica numerica sigue funcionando y se omite la interpretacion.
# ================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANALYTICS_AI_RATE_LIMIT=5
ANALYTICS_AI_CACHE_MIN=120
