# Variables del frontend (Vite). Copia este archivo a ".env" y complétalo; ".env" NO se sube a git.
# En Vercel se definen en Settings > Environment Variables y se aplican en el siguiente despliegue.
# (Vite las incrusta al construir: todo lo que ponga aquí queda visible en el navegador, nunca pongas secretos.)

# Client ID de Google OAuth (Google Cloud Console > Credenciales)
VITE_GOOGLE_CLIENT_ID=

# URL del backend. En local puede omitirse: por defecto usa http://localhost:3000
# En producción debe apuntar al backend desplegado.
VITE_API_URL=
